APP_NAME="DebtOps"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_MY
APP_MAINTENANCE_DRIVER=file
DCMS_BUSINESS_TIMEZONE=Asia/Kuala_Lumpur
# Separate base64-encoded random 32-byte key; retain and rotate with index rebuilding.
DCMS_SEARCH_KEY=
# Configure approved terms and privacy notice before invitation activation.
DCMS_TERMS_VERSION="DCMS Staff Terms v1.0"
DCMS_PRIVACY_URL=https://dcms.intexcode.com/privacy-policy
WWWUSER=1000
WWWGROUP=1000
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=dcms
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5432
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=180
BROADCAST_CONNECTION=log
# Private storage only; production uses IAM task roles, not committed AWS keys.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Local mail sink only. Provider-backed customer sending is a later confirmed module.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_TIMEOUT=15
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dcms.test"
MAIL_FROM_NAME="DebtOps by InteXcode"
PULSE_ENABLED=false
SENTRY_LARAVEL_DSN=
VITE_APP_NAME="DebtOps"

# Stable namespaces retained across the product display-name change.
SESSION_COOKIE=dcms-session
CACHE_PREFIX=dcms-cache-
REDIS_PREFIX=dcms-database-

# M04: optional Sail profile imports; unavailable scanners fail closed.
IMPORT_SCANNER_HOST=clamav
IMPORT_SCANNER_PORT=3310
IMPORT_MAX_KILOBYTES=10240
IMPORT_MAX_ROWS=2000

# M06 multiple selections require a private local temporary volume (encrypted in production).
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# M14 SES is approved; real account/domain/quotas and production approval remain unverified.
MAIL_LIVE_SENDING_ENABLED=false
MAIL_SES_ACCOUNT=
MAIL_DAILY_LIMIT=1000
MAIL_RATE_LIMIT_PER_SECOND=2
MAIL_SANDBOX_ENABLED=true
MAIL_SANDBOX_RECIPIENTS=

# SES receipts stay disabled until the real account/topic and HTTPS subscription are verified.
MAIL_SES_RECEIPTS_ENABLED=false
MAIL_SES_SNS_TOPICS=
MAIL_SES_CONFIGURATION_SET=
