APP_NAME="DCMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_MY
APP_MAINTENANCE_DRIVER=file
DCMS_BUSINESS_TIMEZONE=Asia/Kuala_Lumpur
# Separate base64-encoded random 32-byte key; retain and rotate with index rebuilding.
DCMS_SEARCH_KEY=
# Configure approved terms and privacy notice before invitation activation.
DCMS_TERMS_VERSION=
DCMS_PRIVACY_URL=
WWWUSER=1000
WWWGROUP=1000
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=dcms
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5432
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=180
BROADCAST_CONNECTION=log
# Private storage only; production uses IAM task roles, not committed AWS keys.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Local mail sink only. Provider-backed customer sending is a later confirmed module.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dcms.test"
MAIL_FROM_NAME="DCMS by InteXcode"
PULSE_ENABLED=false
SENTRY_LARAVEL_DSN=
VITE_APP_NAME="DCMS"
